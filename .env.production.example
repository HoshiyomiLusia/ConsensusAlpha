APP_ENV=production
DATABASE_URL=postgresql+psycopg://consensus:CHANGE_ME@postgres:5432/consensus_alpha
API_AUTH_ENABLED=true
API_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

BROKER_PROVIDER=webull
TRADING_MODE=live
ENABLE_LIVE_TRADING=false

WEBULL_ENV=production
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
WEBULL_ACCOUNT_ID=
WEBULL_TRADING_ENDPOINT_PRODUCTION=api.webull.com
WEBULL_MARKET_DATA_ENDPOINT_PRODUCTION=broker-api.webull.com

LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_AGENT_CONFIGS=[]

MAX_POSITION_PCT=0.05
MAX_SINGLE_TRADE_RISK_PCT=0.01
MAX_DAILY_LOSS_PCT=0.02
MIN_AGENT_CONFIDENCE=0.65
TRADE_COOLDOWN_SECONDS=300
MAX_ORDER_PRICE_DEVIATION_PCT=0.05
LIVE_PREVIEW_TTL_SECONDS=300
MAX_DAILY_LIVE_ORDER_COUNT=5
MAX_DAILY_LIVE_NOTIONAL=5000
REGULAR_TRADING_HOURS_ONLY=true

POSTGRES_DB=consensus_alpha
POSTGRES_USER=consensus
POSTGRES_PASSWORD=CHANGE_ME
