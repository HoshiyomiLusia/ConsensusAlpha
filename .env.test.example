APP_ENV=uat
DATABASE_URL=postgresql+psycopg://consensus_test:CHANGE_ME@test-postgres:5432/consensus_alpha_test
API_AUTH_ENABLED=true
API_AUTH_TOKEN=CHANGE_ME_TEST_TOKEN

BROKER_PROVIDER=webull
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

WEBULL_ENV=test
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
WEBULL_ACCOUNT_ID=
WEBULL_TRADING_ENDPOINT_TEST=us-openapi-alb.uat.webullbroker.com
WEBULL_MARKET_DATA_ENDPOINT_TEST=us-broker-api.uat.webullbroker.com

LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_AGENT_CONFIGS=[]

MAX_POSITION_PCT=0.03
MAX_SINGLE_TRADE_RISK_PCT=0.005
MAX_DAILY_LOSS_PCT=0.01
MIN_AGENT_CONFIDENCE=0.65
TRADE_COOLDOWN_SECONDS=300
MAX_ORDER_PRICE_DEVIATION_PCT=0.03
LIVE_PREVIEW_TTL_SECONDS=180
MAX_DAILY_LIVE_ORDER_COUNT=2
MAX_DAILY_LIVE_NOTIONAL=1000
REGULAR_TRADING_HOURS_ONLY=true

POSTGRES_DB=consensus_alpha_test
POSTGRES_USER=consensus_test
